{
  "name": "carvex",
  "private": true,
  "version": "0.1.0",
  "description": "Carvex - Ecommerce de productos Vonixx para detailing (Argentina, venta a pedido)",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "seed": "npm --prefix backend run seed"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
